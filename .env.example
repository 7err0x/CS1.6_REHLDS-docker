# Copy to .env and adjust: cp .env.example .env

# Tag for the locally built image (see Dockerfile).
CS16_IMAGE_NAME=cs16-respawn:latest

# Build-only: HLDS stack versions (Dockerfile stage hlds-base; recipe from BLSAlin/rehlds-cstrike).
# REHLDS_BUILD=3.13.0.788
# METAMOD_VERSION=1.3.0.138
# REGAMEDLL_VERSION=5.26.0.668
# REAPI_VERSION=5.24.0.300
# REUNION_VERSION=0.2.0.25
# AMXX_BASE_URL=https://github.com/alliedmodders/amxmodx/releases/download/1.9.0.5303/amxmodx-1.9.0-git5303-base-linux.tar.gz
# AMXX_CSTRIKE_URL=https://github.com/alliedmodders/amxmodx/releases/download/1.9.0.5303/amxmodx-1.9.0-git5303-cstrike-linux.tar.gz
# LASERMINE_GIT_SHA=7e7a285254ba699a1fcfbb43a7378bfc63acb309

# Game port (TCP + UDP). Clients use UDP to play.
SERVER_PORT=27015

# Slots (also passed on the command line; you can tune default.cfg maxplayers via cstrike/config if needed).
MAX_PLAYERS=16

# Remote console password — change this before exposing the server to the internet.
RCON_PASSWORD=changeme

# First map after container start (default matches baked respawn mapcycle).
START_MAP=fy_iceworld

# Shown in server browser. Use quotes in .env if the name contains spaces, e.g. SERVER_HOSTNAME="My LAN CS"
SERVER_HOSTNAME=CS16-Respawn-Docker

# VAC is OFF (secure 0) in server.cfg + liblist so Steam + non-Steam clients work with ReUnion.
# For VAC on, you need a full Steam dedicated setup; then set secure 1 (see README).

# --- Optional: Biohazard / infection profile (docker compose --profile biohazard up -d) ---
# BIOHAZARD_SERVER_PORT=27017
# BIOHAZARD_RCON_PASSWORD=changeme
# BIOHAZARD_SERVER_HOSTNAME=CS16-Biohazard
# BIOHAZARD_START_MAP=cs_estate

# --- Optional: FastDL HTTP (docker compose --profile fastdl up -d) ---
# Image cs16-fastdl snapshots CS16_IMAGE_NAME at build + merges ./data/cs16-game-assets each start — build: docker compose build cs16 fastdl
# FASTDL_HTTP_PORT=8080
#
# Extra maps/sounds/WAD downloader image (Compose profile download-assets)
# CS16_DOWNLOAD_ASSETS_IMAGE=cs16-download-game-assets:latest
# FASTDL_IMAGE_NAME=cs16-fastdl:latest
